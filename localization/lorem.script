function on_message(self, message_id, message, sender)
	if message_id == hash("set_language") then
		set_language(self, message.language)

		msg.post(self.loading_proxy, "unload")

	elseif message_id == hash("proxy_loaded") then
		-- enable the collection and let the loader know
		msg.post(sender, "init")
		
		msg.post(".", "set_language", {language = self.loading_language})
		self.loading_language = nil
	end
end

function on_input(self, action_id, action)
	if action.pressed and hash("touch") == action_id then
		unset_language(self)

		self.current_language_index = self.current_language_index + 1
		if self.current_language_index > #self.supported_languages then
			self.current_language_index = 1
		end
		local language = self.supported_languages[self.current_language_index]
		load_language(self, language)
	end
end
